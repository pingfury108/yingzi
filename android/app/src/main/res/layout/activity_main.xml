<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp" android:paddingEnd="18dp"
        android:paddingTop="14dp" android:paddingBottom="10dp">

        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_globe"
            app:tint="@color/accent" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="YINGZI"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:letterSpacing="0.2"
            android:textColor="@color/text_2" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/statePill"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="5dp" android:paddingBottom="5dp"
            android:text="未连接"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textColor="@color/text_3" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_2"
            android:contentDescription="设置" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp" android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <io.yingzi.app.RingView
                android:id="@+id/ring"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center_horizontal" />

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View android:layout_width="5dp" android:layout_height="5dp"
                    android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dot_accent" />
                <TextView
                    android:id="@+id/exitLine"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="overseas-hk · 42ms"
                    android:textSize="11sp"
                    android:textColor="@color/text_2" />
            </LinearLayout>

            <!-- 三个统计 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Micro" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="上行" />
                    <TextView android:id="@+id/upValue" style="@style/Num"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:textSize="17sp" android:text="0" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Micro" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="对端" />
                    <TextView android:id="@+id/peersValue" style="@style/Num"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:textSize="17sp" android:text="0" />
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/Micro" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="运行" />
                    <TextView android:id="@+id/uptimeValue" style="@style/Num"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:textSize="17sp" android:text="00:00:00" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/toggle"
                style="@style/CtaButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="建立连接" />

            <TextView style="@style/SectionLabel" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="出口" />

            <HorizontalScrollView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:overScrollMode="never">
                <LinearLayout
                    android:id="@+id/exitChips"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 实时吞吐 -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/Micro" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="实时吞吐" />
                    <TextView style="@style/Micro" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="45S" />
                </LinearLayout>

                <io.yingzi.app.SparkView
                    android:id="@+id/spark"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="12dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="14dp" android:layout_marginBottom="12dp"
                    android:background="@color/line" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="6dp" android:layout_height="6dp"
                        android:background="@drawable/bg_dot_direct" />
                    <TextView android:id="@+id/directCount" style="@style/Num"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="7dp" android:textSize="13sp" android:text="0" />
                    <TextView style="@style/Micro" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="7dp" android:text="直连" />

                    <View android:layout_width="6dp" android:layout_height="6dp"
                        android:background="@drawable/bg_dot_exit" />
                    <TextView android:id="@+id/exitCount" style="@style/Num"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="7dp" android:textSize="13sp" android:text="0" />
                    <TextView style="@style/Micro" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:layout_marginStart="7dp" android:text="代理" />

                    <View android:layout_width="6dp" android:layout_height="6dp"
                        android:background="@drawable/bg_dot_block" />
                    <TextView android:id="@+id/blockCount" style="@style/Num"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="7dp" android:textSize="13sp" android:text="0" />
                    <TextView style="@style/Micro" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="7dp"
                        android:text="拦截" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        app:menu="@menu/nav_main"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemActiveIndicatorStyle="@null"
        app:itemRippleColor="@color/accent_soft"
        style="@style/Widget.Material3.BottomNavigationView" />
</LinearLayout>
