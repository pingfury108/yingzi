<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="协调器地址 (host:port)" android:textSize="12sp" />
        <EditText android:id="@+id/coordinator" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:hint="47.109.61.89:9000" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="节点名" android:textSize="12sp" />
        <EditText android:id="@+id/name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" android:hint="android" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="默认出口节点" android:textSize="12sp" />
        <EditText android:id="@+id/exit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text" android:hint="overseas-hk" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="代理域名 DNS（可 exit://节点/IP 或 tls://IP#SNI）"
            android:textSize="12sp" />
        <EditText android:id="@+id/remoteDns" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:hint="exit://overseas-hk/1.1.1.1:53" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="直连域名 DNS" android:textSize="12sp" />
        <EditText android:id="@+id/directDns" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text"
            android:hint="udp://223.5.5.5" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="网络密钥 (64 位 hex，加密存储)"
            android:textSize="12sp" />
        <EditText android:id="@+id/secret" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="textPassword"
            android:hint="留空则不修改" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="保存（重启 VPN 生效）" />
    </LinearLayout>
</ScrollView>
